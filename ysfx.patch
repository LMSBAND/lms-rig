diff --git a/sources/ysfx_gmem.cpp b/sources/ysfx_gmem.cpp
index 1be4955..3d3c2c8 100644
--- a/sources/ysfx_gmem.cpp
+++ b/sources/ysfx_gmem.cpp
@@ -1,5 +1,6 @@
 #pragma once
 #include "ysfx_gmem.hpp"
+#include "ysfx.h"
 #include "WDL/eel2/ns-eel.h"
 #include <unordered_map>
 #include <mutex>
@@ -113,3 +114,22 @@ void** get_gmem_address(ysfx_t* fx)
     else
         return &it->second->ctx;
 }
+
+bool ysfx_gmem_read(ysfx_t *fx, uint32_t offset, uint32_t count, ysfx_real *out)
+{
+    void **gram = get_gmem_address(fx);
+    if (!gram)
+        return false;
+    EEL_F **blocks = (EEL_F **)*gram;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t w = offset + i;
+        EEL_F v = 0;
+        if (blocks && w < (uint32_t)NSEEL_RAM_BLOCKS * NSEEL_RAM_ITEMSPERBLOCK) {
+            EEL_F *b = blocks[w >> NSEEL_RAM_ITEMSPERBLOCK_LOG2];
+            if (b)
+                v = b[w & (NSEEL_RAM_ITEMSPERBLOCK - 1)];
+        }
+        out[i] = v;
+    }
+    return true;
+}
